# URL of the local llama-server (no trailing slash)
BACKEND_URL=http://10.0.0.60

# Comma-separated list of valid Bearer tokens for incoming webhook requests.
# Generate strong tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
API_TOKENS=your-token-1-here,your-token-2-here

# Cloudflare Tunnel token.
# Create a tunnel at https://one.dash.cloudflare.com/ → Networks → Tunnels,
# choose "cloudflared", copy the token shown during setup.
# Point the tunnel's public hostname to: http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Local port that nginx binds to (useful for direct LAN access without the tunnel)
NGINX_PORT=8088
