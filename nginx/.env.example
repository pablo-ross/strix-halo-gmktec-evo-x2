# ==============================================================================
# LLM API Gateway Configuration
# ==============================================================================
# Copy this file to .env and customize for your setup
# After changes, run: ./setup.sh

# Server Configuration
NGINX_HOST=192.168.100.100
NGINX_PORT=80

# Model Definitions
# Format: MODEL_NAME:PORT:PATTERN1,PATTERN2,...
# PATTERN is used for case-insensitive matching in the "model" field
#
# Example: QWEN3:8080:qwen,qwen3
#   - Routes to port 8080 if model name contains "qwen" or "qwen3"

MODEL_1=QWEN3:8080:qwen,qwen3,coder
MODEL_2=BIELIK:8081:bielik
MODEL_3=QWEN25:8082:qwen2.5,autocomplete,7b
MODEL_4=NOMIC:8083:nomic,embed,embedding
MODEL_5=E5LARGE:8085:e5,e5-large,large-v2

# Default model when no match is found or no model specified
DEFAULT_MODEL=QWEN3

# Nginx Settings
CLIENT_MAX_BODY_SIZE=10M
PROXY_TIMEOUT=300

# ==============================================================================
# Adding a New Model:
# ==============================================================================
# 1. Add a new MODEL_N line (increment the number)
# 2. Specify: NAME:PORT:pattern1,pattern2,...
# 3. Run: ./setup.sh
# 4. Test: ./test.sh
#
# Example for adding a third model:
# MODEL_3=LLAMA:8082:llama,llama3
