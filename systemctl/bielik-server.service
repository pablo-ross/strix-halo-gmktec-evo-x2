[Unit]
Description=llama.cpp bielik-11b
After=network.target user@1000.service llama-server.service
Requires=user@1000.service

[Service]
Type=simple
User=username
WorkingDirectory=/home/username
ExecStart=/home/username/wrappers/bielik-11b-server.sh
ExecStop=/usr/local/bin/distrobox enter llama-rocm-7rc-rocwmma -- /bin/bash -c "/usr/sbin/lsof -ti:8081 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="XDG_RUNTIME_DIR=/run/user/1000"

# Give it time to stop gracefully
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
