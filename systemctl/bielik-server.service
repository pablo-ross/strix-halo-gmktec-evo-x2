[Unit]
Description=llama.cpp bielik-11b-v3.0
After=network.target user@1000.service llama-server.service
Requires=user@1000.service

[Service]
Type=simple
User=mornel
WorkingDirectory=/home/mornel
ExecStart=/home/mornel/wrappers/bielik-11b-server.sh
ExecStop=/bin/bash -c "lsof -ti:8081 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="XDG_RUNTIME_DIR=/run/user/1000"
LimitMEMLOCK=infinity

# Give it time to stop gracefully
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
