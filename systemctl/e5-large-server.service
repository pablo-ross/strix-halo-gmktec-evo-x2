[Unit]
Description=llama.cpp Server - E5-Large-v2 (Embeddings)
After=network.target user@1000.service
Requires=user@1000.service

[Service]
Type=simple
User=username
Group=groupname
WorkingDirectory=/home/username
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/home/username/wrappers/e5-large-server.sh
ExecStop=/usr/local/bin/distrobox enter llama-rocm-7rc-rocwmma -- /bin/bash -c "/usr/sbin/lsof -ti:8085 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10

# Resource limits
MemoryMax=4G
CPUQuota=400%

[Install]
WantedBy=multi-user.target
