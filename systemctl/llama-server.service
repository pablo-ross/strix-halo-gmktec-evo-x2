[Unit]
Description=llama.cpp qwen3-coder
After=network.target user@1000.service
Requires=user@1000.service

[Service]
Type=simple
User=mornel
WorkingDirectory=/home/mornel
ExecStart=/home/mornel/wrappers/qwen3-coder-server.sh
ExecStop=/bin/bash -c "lsof -ti:8080 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="XDG_RUNTIME_DIR=/run/user/1000"
LimitMEMLOCK=infinity

# Give it time to stop gracefully
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
