[Unit]
Description=llama.cpp qwen3-coder
After=network.target

[Service]
Type=simple
User=username
WorkingDirectory=/home/username
ExecStart=/home/username/wrappers/qwen3-coder-server.sh
ExecStop=/usr/local/bin/distrobox enter llama-rocm-7rc-rocwmma -- /bin/bash -c "/usr/sbin/lsof -ti:8080 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="XDG_RUNTIME_DIR=/run/user/1000"

# Give it time to stop gracefully
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
