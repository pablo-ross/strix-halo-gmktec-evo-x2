[Unit]
Description=llama.cpp Server - Nomic Embed v2 MoE (Embeddings)
After=network.target user@1000.service
Requires=user@1000.service

[Service]
Type=simple
User=mornel
Group=mornel
WorkingDirectory=/home/mornel
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/home/mornel/wrappers/nomic-embed-server.sh
ExecStop=/usr/local/bin/distrobox enter llama-rocm-7rc-rocwmma -- /bin/bash -c "/usr/sbin/lsof -ti:8083 | xargs -r kill -TERM"
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10

# Resource limits
MemoryMax=6G
CPUQuota=400%

[Install]
WantedBy=multi-user.target
